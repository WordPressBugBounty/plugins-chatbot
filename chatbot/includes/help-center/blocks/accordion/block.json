{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpbot-help/accordion",
	"title": "Accordion item",
	"category": "wpbot-help",
	"icon": "arrow-down-alt2",
	"description": "A question or title that opens to show more. Works without JavaScript.",
	"keywords": [ "faq", "toggle", "details", "collapse" ],
	"textdomain": "chatbot",
	"attributes": {
		"summary": { "type": "string", "source": "html", "selector": "summary", "default": "" },
		"open": { "type": "boolean", "default": false }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "wpbot-help-blocks-editor",
	"editorStyle": "wpbot-help-blocks-editor",
	"style": "wpbot-help-blocks"
}
