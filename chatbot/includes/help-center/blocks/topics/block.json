{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpbot-help/topics",
	"title": "Help topics",
	"category": "wpbot-help",
	"icon": "list-view",
	"description": "Top-level categories with their first articles.",
	"keywords": [
		"topics",
		"categories",
		"help"
	],
	"textdomain": "chatbot",
	"attributes": {
		"articles": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "wpbot-help-embeds-editor"
}
