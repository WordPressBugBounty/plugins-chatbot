{
  "name": "chatbot",
  "version": "1.0.0",
  "description": "Chatbot plugin packages",
  "main": "main.js",
  "scripts": {
    "prod": "cross-env NODE_ENV=production webpack --mode production --progress",
    "dev": "cross-env NODE_ENV=development webpack --watch --mode development --progress",
    "clean": "rm -rf assets/build/*",
    "svg": "svgr -d assets/src/js/icons assets/src/icons",
    "lint:php": "php -d memory_limit=512M vendor/bin/phpcs --report=full | tee phpcs-out.txt",
    "lint:php:fix": "php -d memory_limit=1024M vendor/bin/phpcbf",
    "lint-css:fix": "npm run lint-css -- --fix",
    "precommit": "npm run lint:php && npm run lint-css:fix && npm run lint:fix && npm run prod",
    "cypress:open": "cypress open",
    "makezip": "webpack --mode production",
    "build-free": "node build-scripts/zip-plugin.js",
    "sync:seo-ai-search": "node build-scripts/sync-seo-ai-search.js",
    "check:seo-ai-search-sync": "node build-scripts/check-seo-ai-search-sync.js",
    "sync:ai-writer": "node build-scripts/sync-ai-writer.js",
    "check:ai-writer-sync": "node build-scripts/check-ai-writer-sync.js",
    "minify": "node build-scripts/minify-assets.js",
    "build:marketing": "webpack --config webpack.marketing.config.js --mode production",
    "sync:asset-optimizer": "node build-scripts/sync-asset-optimizer.js",
    "check:asset-optimizer-sync": "node build-scripts/check-asset-optimizer-sync.js",
    "build": "webpack --config \"webpack.config.js\""
  },
  "keywords": [
    "wordpress",
    "chatbot"
  ],
  "author": "QuantumCloud",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.17.8",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@svgr/cli": "^6.2.1",
    "@wordpress/base-styles": "^4.3.0",
    "@wordpress/block-editor": "^8.4.0",
    "@wordpress/blocks": "^11.4.0",
    "@wordpress/components": "^19.7.0",
    "@wordpress/compose": "^5.3.0",
    "@wordpress/data": "^6.5.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^3.4.1",
    "@wordpress/element": "^4.3.0",
    "@wordpress/hooks": "^3.5.0",
    "@wordpress/i18n": "^4.5.0",
    "@wordpress/icons": "^8.1.0",
    "@wordpress/server-side-render": "^3.3.0",
    "archiver": "^7.0.1",
    "babel-loader": "^8.2.4",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^10.2.4",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "cssnano": "^5.1.7",
    "cypress": "^10.7.0",
    "file-loader": "^6.2.0",
    "lodash": "^4.17.21",
    "mini-css-extract-plugin": "^2.6.0",
   "css-minimizer-webpack-plugin": "^7.0.2",
  "sass": "^1.89.0",
    "sass-loader": "^12.6.0",
    "sass-mq": "^6.0.0",
    "style-loader": "^3.3.1",
    "webpack": "^5.106.2",
    "webpack-cli": "^4.9.2",
    "zip-webpack-plugin": "^4.0.3"
  },
  "browserslist": [
    "defaults"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qcld/chatbot.git"
  },
  "bugs": {
    "url": "https://github.com/qcld/chatbot/issues"
  },
  "homepage": "https://github.com/qcld/chatbot#readme"
}

